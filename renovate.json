{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Bundle Envoy Gateway chart and CRDs so they update together",
      "matchPackageNames": [
        "docker.io/envoyproxy/gateway-helm",
        "docker.io/envoyproxy/gateway-crds-helm"
      ],
      "groupName": "envoy-gateway"
    },
    {
      "description": "Bundle external-snapshotter kustomize ref and tag so they update together",
      "matchPackageNames": [
        "kubernetes-csi/external-snapshotter",
        "https://github.com/kubernetes-csi/external-snapshotter.git"
      ],
      "groupName": "external-snapshotter"
    },
    {
      "description": "Bundle base-image tag and digest updates into one PR",
      "matchPackageNames": [
        "ghcr.io/anokfireball/base-image"
      ],
      "groupName": "base-image"
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/argo/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)gatus\\.ya?ml$/"
      ],
      "matchStrings": [
        "tag:\\s*\"?(?<currentValue>[^\"\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\"?\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)"
      ],
      "autoReplaceStringTemplate": "tag: \"{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\" # renovate: datasource={{{datasource}}} depName={{{depName}}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^argo\\/system\\/oracle-[^/]+\\/kustomization\\.ya?ml$/"
      ],
      "matchStrings": [
        "-\\s*https://raw\\.githubusercontent\\.com/oracle/oci-cloud-controller-manager/refs/tags/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/[^\\s]+\\s*#\\s*renovate:\\s*datasource=github-tags\\s+depName=oracle/oci-cloud-controller-manager"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "oracle/oci-cloud-controller-manager",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^argo\\/system\\/system-upgrade-controller\\/plan\\.yaml$/"
      ],
      "matchStrings": [
        "version:\\s*\"(?<currentValue>[^\"]+)\"\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^argo\\/(apps\\/gatus\\/rollout-hooks|system\\/(system-upgrade-controller\\/plan|kured\\/gatus-handoff-cronjob))\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*\"?ghcr\\.io/anokfireball/base-image:(?<currentValue>[^@\"\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)\"?\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "CNPG PostgreSQL images (Cluster imageName, ImageCatalog image). Major, flavor and Debian release come from the file, so only same-flavor minor and digest updates are proposed.",
      "managerFilePatterns": [
        "/^argo\\/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "imageName:\\s*\"?ghcr\\.io/cloudnative-pg/postgresql:(?<currentValue>(?<pgMajor>\\d+)\\.\\d+-(?<flavor>[a-z]+)-(?<distro>[a-z]+))@(?<currentDigest>sha256:[a-f0-9]+)\"?",
        "image:\\s*\"?ghcr\\.io/cloudnative-pg/postgresql:(?<currentValue>(?<pgMajor>\\d+)\\.\\d+-(?<flavor>[a-z]+)-(?<distro>[a-z]+))@(?<currentDigest>sha256:[a-f0-9]+)\"?"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "ghcr.io/cloudnative-pg/postgresql",
      "versioningTemplate": "regex:^(?<major>{{{pgMajor}}})\\.(?<minor>\\d+)-{{{flavor}}}-{{{distro}}}$",
      "extractVersionTemplate": "^(?<version>{{{pgMajor}}}\\.\\d+-{{{flavor}}}-{{{distro}}})$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "terraform/variables.tf"
      ],
      "matchStrings": [
        "default\\s*=\\s*\"(?<currentValue>[^\"]+)\"\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)"
      ],
      "versioningTemplate": "semver"
    }
  ],
  "kustomize": {
    "managerFilePatterns": [
      "/argo/.+kustomization\\.ya?ml$/"
    ]
  }
}
